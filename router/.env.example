# Documentation-only example; the application does not implicitly load .env files.
# Export these names in your shell if changing defaults. No provider keys are needed.
ROUTER_MODE=fixture
ROUTER_IDENTITY_MODE=local_fixture
ROUTER_DATABASE_URL=sqlite:///.local/router.db
# Local PostgreSQL alternative after docker compose up -d postgres:
# ROUTER_DATABASE_URL=postgresql+psycopg://router@127.0.0.1:55432/router_fixture
# Optional isolated local cached-model server (no pull, cloud, or provider key):
# ROUTER_LOCAL_INTERPRETATION_MODEL=qwen2.5:0.5b
# ROUTER_WEB_ORIGIN=http://127.0.0.1:5184
# Shared identities must be provisioned explicitly using scripts/create_local_user.py:
# ROUTER_IDENTITY_MODE=shared
# ROUTER_AUTH_FILE=.local/users.json
# ROUTER_MODE=live
# Hosted inference remains blocked without separately approved role/key/spend records:
# ROUTER_APPROVALS_FILE=.local/approved-roles.json
# Runtime target execution is separate from planning-role approvals.
# Requires ROUTER_MODE=live and authenticated shared identity, plus an operator-
# owned canonical RuntimeRegistry: exact target/catalog/admission/grant/endpoint
# evidence and server-side secret REFERENCES, never raw keys in this file.
# ROUTER_RUNTIME_REGISTRY_FILE=.local/runtime-registry.json
# Explicit output/checkpoint retention for workflow runs; chat retention stays off:
# ROUTER_RUNTIME_RETENTION_SECONDS=3600
# No registry is seeded automatically. See docs/API_COMPATIBILITY.md.
